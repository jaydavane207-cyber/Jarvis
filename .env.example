# JARVIS API Keys & Configuration — v2.0

# ── Core APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
OPENAI_API_KEY=your_openai_api_key

# ── Smart Home ────────────────────────────────────────────────────────────────
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your_long_lived_access_token

# ── Security & Privacy ───────────────────────────────────────────────────────
# Generate a key using: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
# MASTER_KEY=
# MFA_SECRET=
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token

# ── Safety & Executor (PRD §5.6) ─────────────────────────────────────────────
# Tier: read_only | propose_diff | execute_with_confirmation
EXECUTOR_PERMISSION_TIER=execute_with_confirmation
# Leave empty to allow all directories; comma-separated to restrict
EXECUTOR_WHITELIST_DIRS=
# Commands/languages allowed (empty = all)
EXECUTOR_WHITELIST_COMMANDS=python,java,node,javac,gcc,g++,make,git,css

# ── Proactive Protocols (PRD §5.2) ───────────────────────────────────────────
MORNING_PROTOCOL_TIME=07:30
EVENING_PROTOCOL_TIME=21:00

# ── Trading / Stocks (PRD §5.5) ──────────────────────────────────────────────
TRADING_BUDGET_MIN=10000
TRADING_BUDGET_MAX=50000
# Optional: VirusTotal for URL scam checking (PRD §5.4)
# VIRUSTOTAL_API_KEY=your_virustotal_key

# ── Reliability (PRD §5.8) ───────────────────────────────────────────────────
# Warning threshold in milliseconds for latency regressions
LATENCY_WARNING_THRESHOLD_MS=10000

# ── Server workers (#9) ──────────────────────────────────────────────────────
# Number of uvicorn worker processes. 2 is safe for SQLite (WAL + busy_timeout).
# Increase for multi-user deployments; move to PostgreSQL if SQLite lock errors appear.
WORKER_COUNT=2
